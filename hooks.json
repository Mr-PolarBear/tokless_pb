{
  "read-file-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|view_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/read-guard-hook.js",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "session-summary-bar": {
    "enabled": true,
    "PostInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings ./scripts/session-summary-hook.js",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
